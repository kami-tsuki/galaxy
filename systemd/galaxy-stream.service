[Unit]
Description=Galaxy Moonlight stream
After=network-online.target systemd-user-sessions.service getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service galaxy-obs.service

[Service]
User=@USER@
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=/etc/galaxy/galaxy.env
EnvironmentFile=-/run/user/@UID@/galaxy-session.env
UnsetEnvironment=SUNSHINE_USER SUNSHINE_PASS SUNSHINE_CERT_SHA256 OBS_PASS API_TOKEN
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus
ExecStart=/usr/bin/setpriv --inh-caps=-all /usr/bin/cage -s -- /usr/bin/flatpak run --env=SDL_AUDIODRIVER=${AUDIO_DRIVER} com.moonlight_stream.Moonlight stream ${PC_HOST} ${SUNSHINE_APP} $MOONLIGHT_ARGS $RESOLUTION_FLAGS $AUDIO_FLAGS
ExecStopPost=+/usr/bin/systemctl --no-block start getty@tty1.service
Restart=no
TimeoutStopSec=5
